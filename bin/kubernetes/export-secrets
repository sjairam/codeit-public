#!/usr/bin/env bash
# export-secrets - export Kubernetes secrets into individual YAML files per namespace
# v0.9 - add include service account tokens

set -o errexit
set -o pipefail
set -o nounset

PROG_NAME="${0##*/}"
KUBECTL_BIN="kubectl"
OUTPUT_DIR="./exported-secrets"
INCLUDE_SA_TOKENS=false
RUN_DATE="$(date '+%Y%m%d')"
EXCLUDED_NAMESPACES=(
  kube-system kube-public kube-node-lease default kube-storage-local local-path-storage istio-system cert-manager
  cattle-system cattle-fleet-system cattle-fleet-local-system cattle-fleet-clusters-system
  cattle-global-nt cattle-global-data cattle-impersonation-system cattle-local-user-passwords cattle-monitoring-system
  cattle-resources-system cattle-capi-system cattle-turtles-system cattle-ui-plugin-system cattle-dashboards
)

print_usage() {
  cat <<EOF
Usage: $PROG_NAME [options]

Exports all secrets from each namespace into:
  <output-dir>/<YYYYMMDD>/<namespace>__<secret-name>.yaml

Options:
  -h, --help                  Show this help
  --output-dir <path>         Output directory (default: ./exported-secrets)
  --kubectl <path>            Path to kubectl binary (default: kubectl)
  --include-sa-tokens         Include service account token secrets
EOF
}

sanitize_filename() {
  local name="$1"
  # Replace anything not commonly safe for filenames.
  printf '%s' "$name" | sed 's/[^A-Za-z0-9._-]/_/g'
}

is_excluded_namespace() {
  local namespace="$1"
  local excluded_ns
  for excluded_ns in "${EXCLUDED_NAMESPACES[@]}"; do
    if [ "$namespace" = "$excluded_ns" ]; then
      return 0
    fi
  done
  return 1
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help)
      print_usage
      exit 0
      ;;
    --output-dir)
      OUTPUT_DIR="$2"
      shift 2
      ;;
    --output-dir=*)
      OUTPUT_DIR="${1#*=}"
      shift
      ;;
    --kubectl)
      KUBECTL_BIN="$2"
      shift 2
      ;;
    --kubectl=*)
      KUBECTL_BIN="${1#*=}"
      shift
      ;;
    --include-sa-tokens)
      INCLUDE_SA_TOKENS=true
      shift
      ;;
    *)
      echo "Unknown option: $1" >&2
      print_usage >&2
      exit 2
      ;;
  esac
done

if ! command -v "$KUBECTL_BIN" >/dev/null 2>&1; then
  echo "Error: kubectl not found at '$KUBECTL_BIN' or in PATH." >&2
  exit 3
fi

OUTPUT_DIR="${OUTPUT_DIR}/${RUN_DATE}"
mkdir -p "$OUTPUT_DIR"

echo "Using kubectl: $KUBECTL_BIN" >&2
echo "Output directory: $OUTPUT_DIR" >&2

exported_count=0
namespace_count=0

while IFS= read -r namespace; do
  [ -z "$namespace" ] && continue

  if is_excluded_namespace "$namespace"; then
    echo "[$namespace] skipped (excluded namespace)" >&2
    continue
  fi

  namespace_count=$((namespace_count + 1))

  secrets_found=0
  while IFS= read -r secret_name; do
    [ -z "$secret_name" ] && continue
    secrets_found=1

    if [ "$INCLUDE_SA_TOKENS" = false ]; then
      secret_type="$("$KUBECTL_BIN" get secret "$secret_name" -n "$namespace" -o jsonpath='{.type}')"
      if [ "$secret_type" = "kubernetes.io/service-account-token" ]; then
        continue
      fi
    fi

    secret_file="${OUTPUT_DIR}/$(sanitize_filename "$namespace")__$(sanitize_filename "$secret_name").yaml"
    "$KUBECTL_BIN" get secret "$secret_name" -n "$namespace" -o yaml > "$secret_file"
    exported_count=$((exported_count + 1))
    echo "[$namespace] exported $secret_name -> $secret_file" >&2
  done < <("$KUBECTL_BIN" get secrets -n "$namespace" -o jsonpath='{range .items[*]}{.metadata.name}{"\n"}{end}')

  if [ "$secrets_found" -eq 0 ]; then
    echo "[$namespace] no secrets found" >&2
  fi
done < <("$KUBECTL_BIN" get namespaces -o jsonpath='{range .items[*]}{.metadata.name}{"\n"}{end}')

echo "" >&2
echo "Namespaces processed: $namespace_count" >&2
echo "Secrets exported:     $exported_count" >&2
echo "Done." >&2
