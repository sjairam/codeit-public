outsecrets() {
  local secret_yaml lines
  secret_yaml=$(cat)

  lines=$(printf '%s' "$secret_yaml" | yq e '.data | to_entries[] | .key + "\t" + .value' -)

  while IFS=$'\t' read -r key b64value; do
    printf '%s: ' "$key"
    printf '%s' "$b64value" | tr -d '\r\n' | base64 --decode 2>/dev/null | awk '{ sub(/%[[:space:]]*$/, ""); print }'
  done <<< "$lines"
}

# Restart a k8s deployment and watch pods (need to be in NS)
rrd() {
  local AWS KUBECTL DEPLOYMENT_NAME

  AWS=$(command -v aws)
  KUBECTL=$(command -v kubectl)

  if [ ! -f "${AWS}" ]; then
    echo "ERROR: The aws binary does not exist."
    echo "FIX: Please modify the \${AWS} variable in the program header."
    return 1
  fi

  if [ ! -f "${KUBECTL}" ]; then
    echo "ERROR: The kubectl binary does not exist."
    echo "FIX: Please modify the \${KUBECTL} variable in the program header."
    return 1
  fi

  sleep 2

  if [ "$#" -ne 1 ]; then
    echo "Usage: rrd <deployment-name>"
    return 1
  fi

  DEPLOYMENT_NAME=$1

  kubectl rollout restart deployment "$DEPLOYMENT_NAME"

  sleep 2

  kubectl get pods -owide -w
}

